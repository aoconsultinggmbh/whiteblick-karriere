# Karriereseite – Regeln für All-Inkl. Die Übergangsadresse (kasserver.com) bleibt immer erreichbar.
RewriteEngine On
RewriteCond %{HTTP_HOST} \.kasserver\.com$ [NC]
RewriteRule ^ - [L]

# http → https, mit www → ohne www (die alte Karriereseite lief unter https://whiteblick-karriere.de/ ohne www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.whiteblick-karriere\.de$ [NC]
RewriteRule ^ https://whiteblick-karriere.de%{REQUEST_URI} [L,R=301,NE]

# Konfiguration nie ausliefern
<Files "bewerbung-konfiguration.php">
  Require all denied
</Files>

# Zwischenspeicher: HTML nie, CSS/JS einen Tag, Bilder ein Jahr
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Weiterleitungen alter Adressen (WordPress → neu), Liste: doku/alte-adressen.md
Redirect 301 /job/zfa-zahnmedizinische-fachangestellte-zahnarzthelferin-als-behandlungsassistenz-m-w-d/ /stellen/zfa-behandlungsassistenz-stuttgart.html
Redirect 301 /job/zmp-zmf-dh-zahnmedizinische-prophylaxeassistentin-dentalhygienikerin-m-w-d/ /stellen/zmp-zmf-dh-prophylaxe-stuttgart.html
Redirect 301 /job/zfa-zmp-zmf-zahnmedizinische-fachangestellte-fuer-die-prophylaxe-m-w-d/ /stellen/zfa-zmp-zmf-prophylaxe-stuttgart.html
Redirect 301 /job/ausbildung-als-zfa-zahnmedizinische-fachangestellte-m-w-d-2026/ /stellen/ausbildung-zfa-stuttgart.html
Redirect 301 /job/zahnmedizinische-verwaltungsangestellte-zmv-zfa-fuer-die-abrechnung-m-w-d/ /stellen/zmv-abrechnung-stuttgart.html
RedirectMatch 301 ^/job/?$ /#stellen
RedirectMatch 301 ^/jobs/?$ /#stellen
Redirect 301 /dankesseite/ /danke.html
Redirect 301 /impressum/ /rechtliches/impressum.html
Redirect 301 /datenschutzerklaerung/ /rechtliches/datenschutz.html
Redirect 301 /gleichstellungshinweis/ /rechtliches/gleichstellungshinweis.html

ErrorDocument 404 /404.html
